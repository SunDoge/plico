amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

local plicoFormat = new Step {
  glob = List("*.rs", "*.wgsl")
  check = "cargo run --locked --profile ci -p plico-cli -- fmt --check {{files}}"
}

local cargoManifest = new Step {
  glob = List("Cargo.toml", "Cargo.lock")
  check = "CARGO_BUILD_WARNINGS=deny cargo metadata --locked --no-deps --format-version 1 >/dev/null"
}

local workspaceClippy = new Step {
  glob = List("*.rs", "Cargo.toml", "Cargo.lock")
  check = "CARGO_BUILD_WARNINGS=deny CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 cargo clippy --locked --profile ci --workspace --exclude plico-skia --exclude plico-lvgl --exclude lvgl-esp32p4 --exclude plico-fltk --exclude plico-bevy --features backend-settings/wgpu,plico-shell/global-hotkeys --all-targets -- -D warnings"
}

hooks {
  ["check"] {
    timeout = "2m"
    steps {
      ["cargo-manifest"] = cargoManifest
      ["plico-format"] = plicoFormat
    }
  }

  ["pre-commit"] {
    stash = "git"
    timeout = "2m"
    steps {
      ["cargo-manifest"] = cargoManifest
      ["plico-format"] = plicoFormat
    }
  }

  ["pre-push"] {
    timeout = "10m"
    steps {
      ["cargo-manifest"] = cargoManifest
      ["plico-format"] = plicoFormat
      ["workspace-clippy"] = workspaceClippy
    }
  }

  ["commit-msg"] {
    steps {
      ["conventional-commit"] {
        check = "cog verify --file {{commit_msg_file}}"
      }
    }
  }
}
