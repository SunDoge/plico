<Project>
  <PropertyGroup>
    <!-- Disable only when deliberately using explicit scopes or legacy Body wrappers. -->
    <PlicoComponentInterceptors Condition="'$(PlicoComponentInterceptors)' == ''">true</PlicoComponentInterceptors>
    <InterceptorsNamespaces Condition="'$(PlicoComponentInterceptors)' == 'true'">$(InterceptorsNamespaces);Plico.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="PlicoComponentInterceptors" />
  </ItemGroup>
</Project>
