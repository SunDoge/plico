<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SunDoge.Plico.Testing</PackageId>
    <AssemblyName>SunDoge.Plico.Testing</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>SunDoge</Authors>
    <Description>Native-free component and task testing for Plico.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Plico.CSharp/Plico.CSharp.csproj" /></ItemGroup>
</Project>
