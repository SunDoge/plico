half4 plico_effect(float2 uv) {
    float time = resolution_time_scale.z;
    float strength = values[0].x;
    float wave = 0.5 + 0.5 * sin(uv.x * 8.0 - uv.y * 4.0 + time);
    float glow = exp(-abs(uv.y - 0.5 - 0.18 * sin(uv.x * 6.0 + time * 0.6)) * 9.0);
    float3 base = mix(float3(0.035, 0.06, 0.14), float3(0.12, 0.2, 0.36), uv.x);
    float3 ribbon = mix(float3(0.16, 0.48, 0.92), float3(0.32, 0.8, 0.68), wave);
    return half4(base + ribbon * glow * strength, 1.0);
}
